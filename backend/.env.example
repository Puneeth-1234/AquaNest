# ==============================================================================
# AquaNest Backend Production Environment Template
# Duplicate this file as .env and populate with deployment values.
# NEVER commit real credentials or secret keys to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection String
# e.g., mongodb+srv://<username>:<password>@cluster.mongodb.net/aquanest?retryWrites=true&w=majority
MONGODB_URI=

# JSON Web Token (JWT) Authentication Secrets
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway Credentials
# For test mode: starts with rzp_test_
# For live mode: starts with rzp_live_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Production Frontend Allowed Origins (Comma-separated for multiple domains)
# e.g., https://aquanest.in,https://www.aquanest.in
FRONTEND_URL=
